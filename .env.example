# ==============================================================================
# Variables de Entorno Públicas de Ejemplo - Chifa Mariana SaaS
# ATENCIÓN: NUNCA colocar contraseñas, tokens JWT o credenciales aquí.
# Todos los secretos se obtienen dinámicamente en memoria desde OpenBao.
# ==============================================================================

# Entorno de Ejecución
NODE_ENV=development
PORT=4000

# Endpoint de la Bóveda de Secretos OpenBao
OPENBAO_ADDR=http://localhost:8200
OPENBAO_TOKEN=chifa_dev_root_token_2026

# Endpoints de Servicios
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3000
